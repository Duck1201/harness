# Harness 2.0 — perfil local de reprodução.
#
# TEMPLATE e SYSTEM são herdados do artefato base. O harness injeta o system
# prompt e os schemas a partir de config/tool-registry.json; duplicá-los aqui
# criaria duas fontes de verdade.
FROM huihui_ai/qwen3.5-abliterated:4b

# Perfil medido na RX 7600. Alterações nestes valores criam outro braço de eval.
PARAMETER num_ctx 24576
PARAMETER temperature 0.3
PARAMETER presence_penalty 0
PARAMETER top_k 20
PARAMETER top_p 0.8

# Não fixar aqui: think, seed, num_predict, stop, TEMPLATE ou SYSTEM.
# - think=true pertence ao payload/capability do perfil Ollama;
# - seed pertence a cada execução de bancada;
# - num_predict pertence ao orçamento da rota;
# - stop/template/system pertencem ao artefato e ao adaptador versionados.
